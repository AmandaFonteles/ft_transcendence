# =============================================================================
# .env.example : GABARIT versionne (committe dans git).
# On le copie en .env (make le fait pour toi) ou l'on met les VRAIS secrets.
# Pourquoi deux fichiers : .env.example documente les cles attendues sans jamais
# exposer de secret ; .env (ignore par git) contient les vraies valeurs.
# =============================================================================

# Nom de l'utilisateur PostgreSQL cree au premier demarrage de la base.
# Pourquoi ici : l'image officielle Postgres lit cette variable pour creer le role.
POSTGRES_USER=transcendence

# Mot de passe de cet utilisateur (valeur bidon dans le gabarit).
# Pourquoi "change_me" : signale clairement qu'il faut la remplacer dans le vrai .env.
POSTGRES_PASSWORD=change_me

# Nom de la base de donnees creee au demarrage.
POSTGRES_DB=transcendence

# URL de connexion complete, pratique pour l'ORM (le module Prisma de Ny l'utilisera).
# L'hote est "database" : le nom du service, resolu par le DNS interne de Docker.
# Pourquoi la mettre des maintenant : la brique ORM se branchera sans reconfiguration.
DATABASE_URL=postgresql://transcendence:change_me@database:5432/transcendence

JWT_ACCESS_SECRET=change_me_long_key
JWT_REFRESH_SECRET=change_me_different_long_key
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

FRONTEND_URL=https://localhost:8443

OAUTH_42_CLIENT_ID=change_me
OAUTH_42_CLIENT_SECRET=change_me
OAUTH_42_REDIRECT_URI=https://localhost:8443/api/auth/42/callback

OAUTH_GITHUB_CLIENT_ID=change_me
OAUTH_GITHUB_CLIENT_SECRET=change_me
OAUTH_GITHUB_REDIRECT_URI=https://localhost:8443/api/auth/github/callback

# =============================================================================
# TELEVERSEMENT DE FICHIERS (modele File du schema Prisma)
# =============================================================================

# Dossier ou sont ecrits les fichiers televerses, DANS le conteneur backend.
# Correspond au point de montage du volume nomme "uploads_data" (docker-compose.yml).
# Pourquoi une variable : le code d'Ai ne code aucun chemin en dur ; changer
# l'emplacement ne demande de modifier que le compose et cette ligne.
UPLOAD_DIR=/var/lib/transcendence/uploads

# Taille maximale acceptee par l'APPLICATION, en megaoctets.
# nginx est regle un peu au-dessus (12m dans nginx.conf) pour que le refus vienne du
# backend, avec un message explicite, plutot qu'un 413 brut du reverse proxy.
MAX_UPLOAD_SIZE_MB=10
