// Source de verite des donnees : fichier partage par toute l'equipe.
// Conventions figees : cle primaire toujours "id" en String @default(cuid()),
// champs multi-mots @map en snake_case, tables @@map en snake_case pluriel.

generator client {
  provider      = "prisma-client-js"
  // "native" pour la machine courante, l'autre pour l'image alpine du conteneur.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Identite et authentification -------------------------------------------

// Modele central : presque tout le projet le reference.
model User {
  id String @id @default(cuid())

  email String @unique

  // Genere par le backend, jamais choisi : displayName + "#" + les 5 derniers
  // caracteres d'un cuid. En cas de collision, le dernier caractere est decale
  // de +1 ou -1 en ASCII (voir AuthService.nextSuffix).
  username String @unique

  displayName String @map("display_name")

  avatarUrl String? @map("avatar_url")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  credential Credential?

  oauthAccounts OAuthAccount[]

  organizationMembers OrganizationMember[]

  sentFriendRequests     Friendship[] @relation("FriendshipRequester")
  receivedFriendRequests Friendship[] @relation("FriendshipReceiver")

  isOnline    Boolean  @default(false) @map("is_online")

  @@map("users")
}

// Secrets de connexion, separes de l'identite : User reste l'identite, pas le secret.
model Credential {
  id String @id @default(cuid())

  passwordHash String @map("password_hash")

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // twoFactorSecret est pose des la generation du QR code ; twoFactorEnabled ne
  // passe a true qu'apres validation d'un premier code (voir AuthService).
  twoFactorSecret  String? @map("two_factor_secret")
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")

  @@map("credentials")
}

model OAuthAccount {
  id         String @id @default(cuid())
  provider   String
  providerId String @map("provider_id")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([provider, providerId])
  @@map("oauth_accounts")
}

// --- Relations sociales -----------------------------------------------------

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String   @map("requester_id")
  receiverId  String   @map("receiver_id")

  status      FriendshipStatus @default(PENDING)

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  requester   User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver    User @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@index([receiverId])
  @@map("friendships")
}

// --- Projets et membres -----------------------------------------------------

enum InvitePolicy {
  ADMIN_ONLY
  ANY_MEMBER
}

model Organization {
  id                  String               @id @default(cuid())
  name                String
  description         String?
  invitePolicy        InvitePolicy         @default(ADMIN_ONLY) @map("invite_policy")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  organizationMembers OrganizationMember[]
  tasks               Task[]
  files               File[]
  messages            Message[]

  @@map("organizations")
}

enum Role {
  MEMBER
  ADMIN
}

model OrganizationMember {
  id             String           @id @default(cuid())
  role           Role
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  leftAt         DateTime?        @map("left_at")
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Pas unique seul : on peut appartenir a plusieurs projets, d'ou l'unicite
  // combinee @@unique([userId, organizationId]) plus bas.
  userId         String           @map("user_id")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String           @map("organization_id")
  ownedTasks     Task[]
  assignedTasks  TaskAssignment[]
  ownedFiles     File[]
  fileAccesses   FileAccess[]
  messages       Message[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_members")
}

// --- Taches -----------------------------------------------------------------

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

model TaskAssignment {
  id        String             @id @default(cuid())
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  task      Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String             @map("task_id")
  member    OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  String             @map("member_id")

  @@unique([taskId, memberId])
  @@index([memberId])
  @@map("task_assignments")
}

model Task {
  id              String              @id @default(cuid())
  name            String
  description     String?
  status          TaskStatus          @default(NOT_STARTED)
  startDate       DateTime?           @map("start_date")
  dueDate         DateTime?           @map("due_date")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String              @map("organization_id")
  owner           OrganizationMember? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId         String?             @map("owner_id")
  taskAssignments TaskAssignment[]

  @@index([organizationId])
  @@index([ownerId])
  @@map("tasks")
}

// --- Fichiers ---------------------------------------------------------------

enum VisibilityPolicy {
  PRIVATE
  RESTRICTED
  ALL_MEMBERS
}

model FileAccess {
  id        String             @id @default(cuid())
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  file      File               @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fileId    String             @map("file_id")
  member    OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  String             @map("member_id")

  @@unique([fileId, memberId])
  @@index([memberId])
  @@map("file_accesses")
}

model File {
  id               String              @id @default(cuid())
  name             String
  description      String?
  mimeType         String              @map("mime_type")
  size             Int
  storagePath      String              @unique @map("storage_path")
  visibilityPolicy VisibilityPolicy    @default(ALL_MEMBERS) @map("visibility_policy")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId   String              @map("organization_id")
  owner            OrganizationMember? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId          String?             @map("owner_id")
  fileAccesses     FileAccess[]

  @@index([organizationId])
  @@index([ownerId])
  @@map("files")
}

// --- Chat -------------------------------------------------------------------

model Message {
  id             String             @id @default(cuid())
  content        String
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String             @map("organization_id")
  author         OrganizationMember @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId       String             @map("author_id")

  @@index([organizationId])
  @@index([authorId])
  @@map("messages")
}
